# HTTP mode for remote/hosted deployment
MCP_TRANSPORT=http
PORT=3000

# Public HTTPS origin of the deployed service, without trailing slash.
# Example: https://mcp-app-server.onrender.com
PUBLIC_URL=

# Optional bearer token for remote MCP clients.
# If set, clients must send: Authorization: Bearer <token>
MCP_BEARER_TOKEN=

# CORS origin allowed to call /mcp. Use * only for public/demo servers.
MCP_CORS_ORIGIN=*

# Optional server metadata overrides
MCP_SERVER_NAME=mcp-app-server
MCP_SERVER_VERSION=0.1.0
