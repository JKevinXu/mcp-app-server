{
  "name": "mcp-app-server",
  "version": "0.1.0",
  "description": "Deployable MCP server template for MCP App-compatible hosting.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "mcp-app-server": "dist/src/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/src/index.js",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:apps": "node scripts/smoke-apps.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build:app": "vite build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-app"
  ],
  "author": "JKevinXu <xkevinj@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
