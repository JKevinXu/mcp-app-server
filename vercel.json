{
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/app/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "env": {
    "MCP_TRANSPORT": "http",
    "MCP_CORS_ORIGIN": "*"
  }
}
